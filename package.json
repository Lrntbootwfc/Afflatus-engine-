{
  "name": "affil-main-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:watch": "nodemon",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "nodemonConfig": {
    "exec": "tsx server.ts",
    "watch": [
      "server.ts",
      "server",
      "shared"
    ],
    "ext": "ts,json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "axios": "^1.20.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
