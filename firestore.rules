rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users + AI Match conversation history (owner only under subcollection)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /aiMatchConversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.seekerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.seekerId == request.auth.uid;
    }

    match /works/{workId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.leadCreatorId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.leadCreatorId == request.auth.uid;
    }

    // Proposals / connections (participant only)
    match /connections/{connectionId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileCompleted == true;
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    /**
     * Messages (DMs)
     * Client queries by connectionId only. Firestore requires list rules to be
     * satisfiable by the query constraints — so list is allowed for signed-in users;
     * get still restricts single-doc access to participants.
     * Create: only as sender; update (read receipts): only as recipient.
     */
    match /messages/{messageId} {
      allow get: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 4000;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    // Alerts (owner only)
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && (
          request.resource.data.fromUserId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        );
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.seekerId == request.auth.uid ||
        request.resource.data.collaboratorId == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );
      allow delete: if request.auth != null
        && resource.data.seekerId == request.auth.uid;
    }

    match /workspaces/{projectId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}
