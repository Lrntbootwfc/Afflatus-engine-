rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in [
          'divyasharmagdscoist@gmail.com'
        ];
    }

    function userDocExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myProfileCompleted() {
      return userDocExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.profileCompleted == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      // A user can read their own document.
      // Admin can read user documents when needed.
      allow read: if isOwner(userId) || isAdmin();

      // New authenticated users MUST be able to create
      // their own initial user document.
      allow create: if isOwner(userId);

      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isOwner(userId);

      match /aiMatchConversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }
    }


    // =========================
    // APPLICATIONS
    // =========================
    //
    // IMPORTANT:
    // The application document ID does NOT have to be the user's UID.
    // Authorization is based on request.resource.data.userId instead.
    //
    // This supports both:
    //   applications/{uid}
    // and
    //   applications/{autoGeneratedId}
    //
    match /applications/{applicationId} {

      // Applicant can read their own application.
      // Admin can read applications.
      allow get: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );

      // Admin must be able to retrieve pending applications
      // after refresh/reopening the application window.
      allow list: if isAdmin();

      // A new user can create their own application.
      // It MUST belong to the authenticated user and start as pending.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Applicant may update their own pending application,
      // but cannot change its owner or approve/reject themselves.
      allow update: if
        (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
        )
        ||
        (
          isAdmin()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status in [
            'pending',
            'approved',
            'rejected'
          ]
        );

      // Applications should not be deleted by clients.
      allow delete: if false;
    }


    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {

      // User can read their own notifications.
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Admin can create notifications for applicants.
      // Also preserve existing notification behavior.
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && (
          request.resource.data.fromUserId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }


    // =========================
    // CONNECTIONS
    // =========================

    match /connections/{connectionId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId
        && myProfileCompleted();

      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }


    // =========================
    // MESSAGES
    // =========================

    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId
        && request.resource.data.text is string
        && request.resource.data.text.size() < 4000
        && (
          request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['sharedPost'])
        );

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;

      allow delete: if false;
    }


    // =========================
    // PROJECTS
    // =========================

    match /projects/{projectId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.seekerId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.seekerId == request.auth.uid;
    }


    // =========================
    // WORKS
    // =========================

    match /works/{workId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.creatorId == request.auth.uid;
    }


    // =========================
    // TASKS
    // =========================

    match /tasks/{taskId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.creatorId == request.auth.uid;
    }


    // =========================
    // CLUBS
    // =========================

    match /clubs/{clubId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.leadCreatorId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.leadCreatorId == request.auth.uid;
    }


    // =========================
    // POSTS
    // =========================

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }


    // =========================
    // PORTFOLIO LIKES
    // =========================

    match /portfolioLikes/{itemId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.resource.data.itemId == itemId
        && request.resource.data.creatorId is string
        && request.resource.data.likedBy is list;

      allow delete: if false;
    }


    // =========================
    // MATCHES
    // =========================

    match /matches/{matchId} {
      allow read: if isSignedIn() && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        request.resource.data.seekerId == request.auth.uid ||
        request.resource.data.collaboratorId == request.auth.uid
      );

      allow update: if isSignedIn() && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );

      allow delete: if isSignedIn()
        && resource.data.seekerId == request.auth.uid;
    }


    // =========================
    // WORKSPACES
    // =========================

    match /workspaces/{projectId} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn();

      allow delete: if false;
    }
  }
}