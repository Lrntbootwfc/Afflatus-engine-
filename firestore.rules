rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in [
          'divyasharmagdscoist@gmail.com'
        ];
    }
    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userDocExists() {
      return isSignedIn() && exists(myUserPath());
    }
    // Interaction (collaborate / message / post / like) after basic profile is saved
    function canInteract() {
      return userDocExists()
        && get(myUserPath()).data.profileCompleted == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
    // -------- USERS --------
    // Public read so Explore can show APPROVED creators (client filters pending).
    // Owner may edit profile immediately after approval, even if incomplete.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
      match /aiMatchConversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }
    }
    // -------- APPLICATIONS --------
    match /applications/{userId} {
      allow get: if isOwner(userId) || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid;
      allow update: if
        (
          isOwner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.userId == request.auth.uid
        )
        ||
        (
          isAdmin()
          && request.resource.data.status in ['pending', 'approved', 'rejected']
        );
      allow delete: if false;
    }
    // -------- NOTIFICATIONS --------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && (
          request.resource.data.fromUserId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || isAdmin()
        );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    // -------- CONNECTIONS (proposals / DMs) --------
    match /connections/{connectionId} {
      // Missing doc must be readable so the client can check existence
      // of deterministic ids (dm_uidA_uidB) before create.
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/connections/$(connectionId))
        || resource.data.senderId == request.auth.uid
        || resource.data.recipientId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn()
        && canInteract()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }
    // -------- MESSAGES --------
    match /messages/{messageId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/messages/$(messageId))
        || resource.data.senderId == request.auth.uid
        || resource.data.recipientId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && canInteract()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.recipientId
        && request.resource.data.text is string
        && request.resource.data.text.size() < 4000
        && (
          request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['sharedPost'])
        );
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }
    // -------- CONTENT / EXPLORE --------
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn() && canInteract()
        && request.resource.data.seekerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.seekerId == request.auth.uid;
    }
    match /works/{workId} {
      allow read: if true;
      allow create: if isSignedIn() && canInteract()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isSignedIn() && canInteract()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isSignedIn() && canInteract()
        && request.resource.data.leadCreatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.leadCreatorId == request.auth.uid;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && canInteract()
        && request.resource.data.authorId == request.auth.uid;
      // Author can edit caption/media; completed profiles may toggle likes
      // (Admin API uses likes[]; legacy likedBy/likeCount also allowed).
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (
          canInteract()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likes', 'likedBy', 'likeCount', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    match /portfolioLikes/{itemId} {
      allow read: if true;
      allow create, update: if isSignedIn() && canInteract()
        && request.resource.data.itemId == itemId
        && request.resource.data.creatorId is string
        && request.resource.data.likedBy is list;
      allow delete: if false;
    }
    match /matches/{matchId} {
      allow read: if isSignedIn() && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );
      allow create: if isSignedIn() && canInteract() && (
        request.resource.data.seekerId == request.auth.uid ||
        request.resource.data.collaboratorId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.seekerId == request.auth.uid;
    }
    match /workspaces/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && canInteract();
      allow delete: if false;
    }
  }
}
