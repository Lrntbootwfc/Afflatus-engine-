PORT=3000

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Add your deployed frontend's URL here when you ship it.
ALLOWED_ORIGINS=http://localhost:5173

# Gemini is still used by Main Backend for existing assistant/brief routes
# (AI Backend is preferred for new internal flows)
GEMINI_API_KEY=

# AI Backend (Phase 1 split)
AI_BACKEND_URL=http://localhost:3001
INTERNAL_AI_SERVICE_SECRET=dev-internal-secret-change-me

# Optional Firebase Admin (later phases — not required for current in-memory DB)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
